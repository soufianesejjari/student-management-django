# Django production environment example.
# Do not commit real secrets. Set these in the host/CI secret manager.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-characters
ALLOWED_HOSTS=api.your-domain.com,your-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# Database
DB_ENGINE=postgresql
DB_NAME=musical_academy
DB_USER=musical_academy
DB_PASSWORD=replace-with-database-password
DB_HOST=replace-with-database-host
DB_PORT=5432

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=The Musical Academy <your-email@gmail.com>

# TMA Connect (keep the real key in the host secret manager)
TMA_SYNC_ENABLED=True
TMA_SYNC_API_URL=https://tma-connect.vercel.app/api/sync/eleve
SYNC_API_KEY=replace-with-the-private-sync-key

# HTTPS / proxy security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Enable only when the domain and all subdomains are permanently HTTPS-ready.
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=True
